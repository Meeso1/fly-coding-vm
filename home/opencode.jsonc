{
  "$schema": "https://opencode.ai/config.json",
  // Unattended VM: auto-approve tools instead of prompting.
  // Tighten with `policies` (deny) if you want hard blocks, e.g. destructive shell.
  "permissions": {
    "shell": "allow",
    "edit": "allow",
    "read": "allow",
    "webfetch": "allow",
    "external_directory": "allow"
  }
}
